{
  "name": "orbital-scrapper",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc -p tsconfig.json",
    "test": "rm -rf .test-dist && tsc -p tsconfig.test.json && node --test .test-dist/test/*.test.js",
    "test:phase0": "rm -rf .test-dist && tsc -p tsconfig.test.json && node --test .test-dist/test/fixedStepLoop.test.js .test-dist/test/inputBindings.test.js .test-dist/test/physicsSandbox.test.js .test-dist/test/scenePresenter.test.js",
    "test:phase1": "rm -rf .test-dist && tsc -p tsconfig.test.json && node --test .test-dist/test/fixedStepLoop.test.js .test-dist/test/flightInputBindings.test.js .test-dist/test/flightSandbox.test.js .test-dist/test/flightScenePresenter.test.js .test-dist/test/inputBindings.test.js .test-dist/test/physicsSandbox.test.js .test-dist/test/scenePresenter.test.js",
    "test:phase2": "rm -rf .test-dist && tsc -p tsconfig.test.json && node --test .test-dist/test/fixedStepLoop.test.js .test-dist/test/flightInputBindings.test.js .test-dist/test/flightSandbox.test.js .test-dist/test/flightScenePresenter.test.js .test-dist/test/inputBindings.test.js .test-dist/test/physicsSandbox.test.js .test-dist/test/scenePresenter.test.js .test-dist/test/wreckSandbox.test.js .test-dist/test/wreckScenePresenter.test.js",
    "test:phase3": "rm -rf .test-dist && tsc -p tsconfig.test.json && node --test .test-dist/test/cuttingSystem.test.js .test-dist/test/fixedStepLoop.test.js .test-dist/test/flightInputBindings.test.js .test-dist/test/flightSandbox.test.js .test-dist/test/flightScenePresenter.test.js .test-dist/test/inputBindings.test.js .test-dist/test/physicsSandbox.test.js .test-dist/test/scenePresenter.test.js .test-dist/test/wreckSandbox.test.js .test-dist/test/wreckScenePresenter.test.js",
    "test:phase4": "rm -rf .test-dist && tsc -p tsconfig.test.json && node --test .test-dist/test/cuttingSystem.test.js .test-dist/test/fixedStepLoop.test.js .test-dist/test/flightInputBindings.test.js .test-dist/test/flightSandbox.test.js .test-dist/test/flightScenePresenter.test.js .test-dist/test/inputBindings.test.js .test-dist/test/physicsSandbox.test.js .test-dist/test/scenePresenter.test.js .test-dist/test/tetherSystem.test.js .test-dist/test/wreckSandbox.test.js .test-dist/test/wreckScenePresenter.test.js",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "smoke:phase1": "node scripts/phase1-smoke.mjs",
    "smoke:phase2": "node scripts/phase2-smoke.mjs",
    "smoke:phase3": "node scripts/phase3-smoke.mjs",
    "smoke:phase4": "node scripts/phase4-smoke.mjs",
    "smoke:phase5": "node scripts/phase5-smoke.mjs",
    "verify:phase0": "npm run verify:phase0-regression",
    "verify:phase0-regression": "npm run test:phase0 && npm run build",
    "verify:phase1": "npm run verify:phase1-regression",
    "verify:phase1-regression": "npm run test:phase1 && npm run build",
    "verify:phase2": "npm run verify:phase2-regression",
    "verify:phase2-regression": "npm run test:phase2 && npm run build",
    "verify:phase3": "npm run verify:phase3-regression",
    "verify:phase3-regression": "npm run test:phase3 && npm run build",
    "verify:phase4": "npm run verify:phase4-regression",
    "verify:phase4-regression": "npm run test:phase4 && npm run build",
    "verify:phase5": "npm run test && npm run build && npm run smoke:phase5"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "0.19.3",
    "three": "0.185.0"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "vite": "8.2.1"
  }
}
